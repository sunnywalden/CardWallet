rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Vault config ---
    // v2 (legacy): PIN-wrapped DEK readable anywhere; kept only for the client's transparent
    //     migration to v3. v3 (current): the PIN-wrapped payload + verifier live inside a
    //     device-key seal, so the cloud document alone cannot verify PIN guesses offline.
    // Both require PBKDF2-HMAC-SHA256 with a 120k iteration floor. v1 is rejected everywhere.
    function isValidVaultConfigV2(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.wrappedDekBase64 is string && data.wrappedDekBase64.size() >= 16 && data.wrappedDekBase64.size() <= 512 &&
             data.wrappedDekIvBase64 is string && data.wrappedDekIvBase64.size() >= 8 && data.wrappedDekIvBase64.size() <= 128 &&
             data.kdfSaltBase64 is string && data.kdfSaltBase64.size() >= 8 && data.kdfSaltBase64.size() <= 128 &&
             data.kdfIterations is int && data.kdfIterations >= 120000 && data.kdfIterations <= 1000000 &&
             data.kdfAlgorithm is string && data.kdfAlgorithm == 'PBKDF2WithHmacSHA256' &&
             data.pinVerifierBase64 is string && data.pinVerifierBase64.size() >= 16 && data.pinVerifierBase64.size() <= 256 &&
             data.schemaVersion is int && data.schemaVersion == 2 &&
             !('deviceBinding' in data) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidVaultConfigV3(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.schemaVersion is int && data.schemaVersion == 3 &&
             data.deviceBinding is string && data.deviceBinding == 'ANDROID_KEYSTORE' &&
             data.wrappedDekBase64 is string && data.wrappedDekBase64.size() >= 64 && data.wrappedDekBase64.size() <= 1024 &&
             data.wrappedDekIvBase64 is string && data.wrappedDekIvBase64.size() >= 8 && data.wrappedDekIvBase64.size() <= 128 &&
             data.kdfSaltBase64 is string && data.kdfSaltBase64.size() >= 8 && data.kdfSaltBase64.size() <= 128 &&
             data.kdfIterations is int && data.kdfIterations >= 120000 && data.kdfIterations <= 1000000 &&
             data.kdfAlgorithm is string && data.kdfAlgorithm == 'PBKDF2WithHmacSHA256' &&
             data.pinVerifierBase64 is string && data.pinVerifierBase64 == 'device-bound:v3' &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidVaultConfig(data, userId) {
      return isValidVaultConfigV2(data, userId) || isValidVaultConfigV3(data, userId);
    }

    function isValidCategory(category) {
      return category in ['RESIDENCE', 'OFFICE', 'CAMPUS', 'PARKING', 'TRANSIT', 'OTHER'];
    }

    function isValidAccentColor(color) {
      return color in ['CYAN', 'EMERALD', 'INDIGO', 'AMBER', 'ROSE'];
    }

    function isValidPrimaryTech(tech) {
      return tech in ['ISO_DEP', 'NFC_A', 'NFC_B', 'NFC_F', 'NFC_V', 'MIFARE_CLASSIC', 'MIFARE_ULTRALIGHT', 'NDEF', 'OTHER'];
    }

    function isValidAccessCard(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 40 &&
             data.category is string && isValidCategory(data.category) &&
             data.accentColor is string && isValidAccentColor(data.accentColor) &&
             data.primaryTech is string && isValidPrimaryTech(data.primaryTech) &&
             data.maskedUid is string && data.maskedUid.size() <= 24 &&
             data.hceSupported is bool &&
             data.activeHce is bool &&
             data.encryptedPayloadBase64 is string && data.encryptedPayloadBase64.size() >= 16 && data.encryptedPayloadBase64.size() <= 8192 &&
             data.payloadIvBase64 is string && data.payloadIvBase64.size() >= 8 && data.payloadIvBase64.size() <= 64 &&
             data.emulationCount is int && data.emulationCount >= 0 && data.emulationCount <= 1000000 &&
// v1 (no-AAD) card support was removed on 2026-11-20 after the live audit
             // showed 100% v2; documents without cryptoVersion are no longer writable.
             data.cryptoVersion is int && data.cryptoVersion == 2 &&
             (!('lastEmulatedAt' in data) || data.lastEmulatedAt == null || (data.lastEmulatedAt is timestamp && data.lastEmulatedAt <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/vault/{configId} {
      allow get: if isOwner(userId) && configId == 'config';
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       configId == 'config' &&
                       incoming().keys().hasOnly(['userId', 'wrappedDekBase64', 'wrappedDekIvBase64', 'kdfSaltBase64', 'kdfIterations', 'kdfAlgorithm', 'pinVerifierBase64', 'schemaVersion', 'deviceBinding', 'createdAt', 'updatedAt']) &&
                       isValidVaultConfig(incoming(), userId);

      // v2 -> v3 is a full rewrite; schemaVersion may only move forward (v1 docs are dead).
      allow update: if isOwner(userId) &&
                       configId == 'config' &&
                       isValidVaultConfig(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().schemaVersion >= existing().schemaVersion &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['wrappedDekBase64', 'wrappedDekIvBase64', 'kdfSaltBase64', 'kdfIterations', 'kdfAlgorithm', 'pinVerifierBase64', 'schemaVersion', 'deviceBinding', 'updatedAt']);

      allow delete: if isOwner(userId) && configId == 'config';
    }

    match /users/{userId}/cards/{cardId} {
      allow get: if isOwner(userId) && isValidId(cardId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(cardId) &&
                       incoming().keys().hasOnly(['userId', 'label', 'category', 'accentColor', 'primaryTech', 'maskedUid', 'hceSupported', 'activeHce', 'encryptedPayloadBase64', 'payloadIvBase64', 'cryptoVersion', 'emulationCount', 'lastEmulatedAt', 'createdAt', 'updatedAt']) &&
                       isValidAccessCard(incoming(), userId) &&
                       incoming().cryptoVersion == 2;

      allow update: if isOwner(userId) &&
                       isValidId(cardId) &&
                       isValidAccessCard(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // HCE slot switch only (checked first so v1 cards without cryptoVersion never error).
                         incoming().diff(existing()).affectedKeys().hasOnly(['activeHce', 'updatedAt']) ||
                         // Emulation counter: strictly atomic +1.
                         (incoming().diff(existing()).affectedKeys().hasOnly(['emulationCount', 'lastEmulatedAt', 'updatedAt']) &&
                          incoming().emulationCount == existing().emulationCount + 1) ||
                         // Full content edit; cryptoVersion may only move forward (v1 -> v2 migration).
                         (incoming().diff(existing()).affectedKeys().hasOnly(['label', 'category', 'accentColor', 'primaryTech', 'maskedUid', 'hceSupported', 'activeHce', 'encryptedPayloadBase64', 'payloadIvBase64', 'cryptoVersion', 'updatedAt']) &&
                          incoming().get('cryptoVersion', 1) >= existing().get('cryptoVersion', 1))
                       );

      allow delete: if isOwner(userId) && isValidId(cardId);
    }
  }
}